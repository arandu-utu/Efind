# E-Find — configuración de Apache a nivel de directorio.
#
# Apache sirve los .js sin declarar charset, y el navegador entonces los
# interpreta como ISO-8859-1: los acentos y emojis de js/i18n.js se ven
# corruptos ("Iniciar sesi&oacute;n" y similares). Estas dos líneas lo arreglan.
# Requiere AllowOverride All en el VirtualHost.

AddDefaultCharset UTF-8
AddCharset UTF-8 .js

# El repositorio trae una página de error propia, pero sin esta línea Apache
# sigue devolviendo la suya.
ErrorDocument 404 /404.html

# Archivos del repositorio que no forman parte del sitio.
<FilesMatch "^(README\.md|\.gitignore)$">
  Require all denied
</FilesMatch>

# Cabeceras de seguridad. Requieren mod_headers (a2enmod headers).
# Referrer-Policy importa sobre todo en restablecer.html: el token de
# recuperación viaja en la URL y no debe filtrarse a otro sitio.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
